{
  "name": "@deepseek-ai/dsh-page-app-fixture",
  "description": "Real Cordis-free Workspace Apps Feature fixture: contract-v1 workspace manifest, bundle patch, and a keyed workspace surface registration (M9 migrates it to the workbench contract)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/examples/page-app-fixture"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "workspace": {
      "schemaVersion": 1,
      "id": "dsh-page-app-fixture",
      "name": "Page App Fixture",
      "description": "Cordis-free Workspace Apps feature skeleton",
      "defaultOrder": 100,
      "rootEntryId": "dsh-page-app-fixture-root"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-page-app-profile": "workspace:^"
  }
}
